# Copy this file to `.env.local` and fill in your Anthropic API key.
# The key is read ONLY on the server (in app/api/chat/route.ts via lib/ai.ts).
# Never prefix it with NEXT_PUBLIC_ — that would expose it to the browser.

# Required: Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model id used by lib/ai.ts
# AI_MODEL=claude-sonnet-4-20250514

# Optional: override the max tokens for a single response
# AI_MAX_TOKENS=2048
